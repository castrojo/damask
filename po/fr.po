#: src/sources/wallhaven.vala:466
msgid "<tt>tagname</tt>"
msgstr "<tt>motclé</tt>"

#: src/sources/wallhaven.vala:466
msgid "search fuzzily for a tag/keyword"
msgstr "rechercher vaguement une balise / un mot clé"

#: src/sources/wallhaven.vala:467
msgid "<tt>-tagname</tt>"
msgstr "<tt>-motclé</tt>"

#: src/sources/wallhaven.vala:467
msgid "exclude a tag/keyword"
msgstr "exclure une balise / un mot-clé"

#: src/sources/wallhaven.vala:468
msgid "<tt>+tag1 +tag2</tt>"
msgstr "<tt>+motclé1 +motclé2</tt>"

#: src/sources/wallhaven.vala:468
msgid "must have tag1 and tag2"
msgstr "doit contenir les mot-clés 1 et 2"

#: src/sources/wallhaven.vala:469
msgid "<tt>+tag1 -tag2</tt>"
msgstr "<tt>+motclé1 -motclé2</tt>"

#: src/sources/wallhaven.vala:469
msgid "must have tag1 and NOT tag2"
msgstr "doit contenir le mot-clé 1 sans le 2"

#: src/sources/wallhaven.vala:470
msgid "<tt>@username</tt>"
msgstr "<tt>@nomd’utilisateur</tt>"

#: src/sources/wallhaven.vala:470
msgid "user uploads"
msgstr "par un utilisateur"

#: src/sources/wallhaven.vala:471
msgid "<tt>id:123</tt>"
msgstr "<tt>id:123</tt>"

#: src/sources/wallhaven.vala:471
msgid "Exact tag search (can not be combined)"
