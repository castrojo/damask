#: src/sources/wallhaven.vala:433
msgid "<tt>tagname</tt>"
msgstr "<tt>nombredeetiqueta</tt>"

#: src/sources/wallhaven.vala:433
msgid "search fuzzily for a tag/keyword"
msgstr "búsqueda difusa de una etiqueta/palabra clave"

#: src/sources/wallhaven.vala:434
msgid "<tt>-tagname</tt>"
msgstr "<tt>-nombredeetiqueta</tt>"

#: src/sources/wallhaven.vala:434
msgid "exclude a tag/keyword"
msgstr "excluir una etiqueta/palabra clave"

#: src/sources/wallhaven.vala:435
msgid "<tt>+tag1 +tag2</tt>"
msgstr "<tt>+etiqueta1 +etiqueta2</tt>"

#: src/sources/wallhaven.vala:435
msgid "must have tag1 and tag2"
msgstr "debe tener etiqueta1 y etiqueta2"

#: src/sources/wallhaven.vala:436
msgid "<tt>+tag1 -tag2</tt>"
msgstr "<tt>+etiqueta1 -etiqueta2</tt>"

#: src/sources/wallhaven.vala:436
msgid "must have tag1 and NOT tag2"
msgstr "debe tener etiqueta1 y NO etiqueta2"

#: src/sources/wallhaven.vala:437
msgid "<tt>@username</tt>"
msgstr "<tt>@usuario</tt>"

#: src/sources/wallhaven.vala:437
msgid "user uploads"
msgstr "subidas de usuarios"

#: src/sources/wallhaven.vala:438
msgid "<tt>id:123</tt>"
msgstr "<tt>id:123</tt>"

#: src/sources/wallhaven.vala:438
msgid "Exact tag search (can not be combined)"
msgstr "Búsqueda por etiqueta exacta (no combinable)"

#: src/sources/wallhaven.vala:439
msgid "<tt>type:{png/jpg}</tt>"
msgstr "<tt>tipo:{png/jpg}</tt>"

#: src/sources/wallhaven.vala:439
msgid "Search for file type (jpg = jpeg)"
msgstr "Buscar por tipo de archivo (jpg = jpeg)"

#: src/sources/wallhaven.vala:440
msgid "<tt>like:wallpaper ID</tt>"
msgstr "<tt>como:ID del fondo de pantalla</tt>"

#: src/sources/wallhaven.vala:440
msgid "Find wallpapers with similar tags"
msgstr "Buscar fondos de pantalla con etiquetas similares"
