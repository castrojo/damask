<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2022-2023 Link Dupont -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>Damask</name>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-cartoon">moderate</content_attribute>
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="violence-realistic">moderate</content_attribute>
    <content_attribute id="violence-bloodshed">moderate</content_attribute>
    <content_attribute id="violence-desecration">moderate</content_attribute>
    <content_attribute id="violence-slavery">mild</content_attribute>
    <content_attribute id="drugs-alcohol">moderate</content_attribute>
    <content_attribute id="drugs-narcotics">moderate</content_attribute>
    <content_attribute id="drugs-tobacco">moderate</content_attribute>
    <content_attribute id="sex-nudity">intense</content_attribute>
    <content_attribute id="sex-themes">moderate</content_attribute>
    <content_attribute id="language-profanity">intense</content_attribute>
    <content_attribute id="language-humor">intense</content_attribute>
    <content_attribute id="language-discrimination">mild</content_attribute>
    <content_attribute id="money-gambling">moderate</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer_name>Link Dupont</developer_name>
  <summary>Automatically set a background from the Internet</summary>
  <description>
    <p>Damask is an automatic wallpaper application. It currently supports setting the wallpaper image from the following sources:</p>
    <ul>
      <li>wallhaven.cc</li>
      <li>Microsoft Bing Wallpaper of the day</li>
      <li>NASA Astronomy Picture of the Day</li>
      <li>Unsplash</li>
      <li>Google Earth View</li>
    </ul>
  </description>
  <url type="homepage">https://gitlab.gnome.org/subpop/damask</url>
  <url type="bugtracker">https://gitlab.gnome.org/subpop/damask/-/issues</url>
  <url type="help">https://gitlab.gnome.org/subpop/damask/-/issues</url>
  <url type="translate">https://gitlab.gnome.org/subpop/damask/-/issues</url>
  <releases>
    <release date="2023-08-25" version="0.2.1">
      <description translatable="no">
        <ul>
          <li>Select the source row when setting the active source</li>
          <li>Switches are set to the correct state when bound to preference values</li>
          <li>Add a placeholder for empty image previews</li>
          <li>Wallhaven: correctly set top list range sensitivity when selecting "sort by" option</li>
        </ul>
      </description>
    </release>
    <release date="2023-05-18" version="0.2.0">
      <description translatable="no">
        <ul>
          <li>Updated UI, using a list of sources and preference pages</li>
          <li>Added Google EarthView as a new source</li>
          <li>Updated minimal GTK version to 4.10 and fixed deprecation notices</li>
        </ul>
      </description>
    </release>
    <release date="2023-04-27" version="0.1.5">
      <description translatable="no">
        <ul>
          <li>Fixed an issue initializing translations</li>
          <li>Report errors as a window toast</li>
          <li>Fixed a crash in the Unsplash source using the wrong settings key name</li>
        </ul>
      </description>
    </release>
    <release date="2023-04-06" version="0.1.4">
      <description translatable="no">
        <ul>
          <li>Added French and Dutch translations</li>
          <li>Added "Slideshow" source to rotate through images in a local folder</li>
          <li>Fixed an issue using the Wallhaven NSFW filter without an API key</li>
          <li>Fixed an issue using the Unsplash ncontent_filter setting</li>
          <li>Changed the default refresh interval to 15 minutes</li>
          <li>Fix a crash when disabling autostart</li>
        </ul>
      </description>
    </release>
    <release date="2023-01-27" version="0.1.3">
      <description translatable="no">
        <ul>
          <li>Add "wallpaper" keyword to desktop file</li>
          <li>Disable "Anime" category in the wallhaven source by default</li>
          <li>Dynamically disable sources that require certain values such as API key to function</li>
        </ul>
      </description>
    </release>
    <release date="2023-01-20" version="0.1.2"/>
    <release date="2023-01-19" version="0.1.1"/>
    <release date="2023-01-18" version="0.1.0"/>
  </releases>
  <screenshots>
    <screenshot type="default">
      <image>https://gitlab.gnome.org/subpop/damask/-/raw/main/data/damask.png</image>
    </screenshot>
  </screenshots>
</component>

