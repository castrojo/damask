<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="damask">
  <enum id="@APP_ID@.refresh_interval">
    <value nick="30" value="0"/>
    <value nick="60" value="1"/>
    <value nick="300" value="2"/>
    <value nick="900" value="3"/>
    <value nick="1800" value="4"/>
    <value nick="3600" value="5"/>
    <value nick="21600" value="6"/>
    <value nick="43200" value="7"/>
    <value nick="86400" value="8"/>
  </enum>

	<schema id="@APP_ID@" path="@RESOURCE_PATH@/">
		<key name="refresh-interval" enum="@APP_ID@.refresh_interval">
			<default>"900"</default>
		</key>

		<key name="active-source" type="s">
			<default>"manual"</default>
		</key>

		<key name="run-in-background" type="b">
			<default>true</default>
		</key>

		<key name="autostart" type="b">
			<default>false</default>
		</key>

	  <key name="enable-automatic-refresh" type="b">
	    <default>true</default>
	  </key>
	</schema>

  <enum id="@APP_ID@.sources.wallhaven.sort_by">
    <value nick="date_added" value="0"/>
    <value nick="relevance" value="1"/>
    <value nick="random" value="2"/>
    <value nick="views" value="3"/>
    <value nick="favorites" value="4"/>
    <value nick="toplist" value="5"/>
  </enum>

  <enum id="@APP_ID@.sources.wallhaven.search_mode">
    <value nick="query" value="0"/>
    <value nick="collections" value="2"/>
  </enum>

  <enum id="@APP_ID@.sources.wallhaven.top_list_range">
    <value nick="1d" value="0"/>
    <value nick="3d" value="1"/>
    <value nick="1w" value="2"/>
    <value nick="1M" value="3"/>
    <value nick="3M" value="4"/>
    <value nick="6M" value="5"/>
    <value nick="1y" value="6"/>
  </enum>

	<schema id="@APP_ID@.sources.wallhaven" path="@RESOURCE_PATH@/sources/wallhaven/">
		<key name="username" type="s">
			<default>""</default>
		</key>

		<key name="api-key" type="s">
			<default>""</default>
		</key>

		<key name="search-mode" enum="@APP_ID@.sources.wallhaven.search_mode">
			<default>"query"</default>
		</key>

		<key name="query" type="s">
			<default>""</default>
		</key>

		<key name="collection-id" type="u">
			<default>0</default>
		</key>

		<key name="sort-by" enum="@APP_ID@.sources.wallhaven.sort_by">
			<default>"date_added"</default>
		</key>

		<key name="sort-order" type="i">
			<default>1</default>
		</key>

		<key name="top-list-range" enum="@APP_ID@.sources.wallhaven.top_list_range">
			<default>"1d"</default>
		</key>

		<key name="category-general" type="b">
			<default>true</default>
		</key>

		<key name="category-anime" type="b">
			<default>false</default>
		</key>

		<key name="category-people" type="b">
			<default>true</default>
		</key>

		<key name="purity-sfw" type="b">
			<default>true</default>
		</key>

		<key name="purity-sketchy" type="b">
			<default>false</default>
		</key>

		<key name="purity-nsfw" type="b">
			<default>false</default>
		</key>

		<key name="color-enabled" type="b">
			<default>false</default>
		</key>

		<key name="color" type="s">
			<default>"rgba(0,0,0)"</default>
		</key>
	</schema>

  <enum id="@APP_ID@.sources.bing.market">
    <value nick="en-US" value="0"/>
    <value nick="zh-CN" value="1"/>
    <value nick="ja-JP" value="2"/>
    <value nick="en-AU" value="3"/>
    <value nick="en-GB" value="4"/>
    <value nick="de-DE" value="5"/>
    <value nick="en-NZ" value="6"/>
    <value nick="en-CA" value="7"/>
    <value nick="en-IN" value="8"/>
    <value nick="fr-FR" value="9"/>
    <value nick="fr-CA" value="10"/>
  </enum>

  <enum id="@APP_ID@.sources.bing.resolution">
    <value nick="1920x1080" value="0"/>
    <value nick="1366x768" value="1"/>
    <value nick="UHD (3840x2160)" value="2"/>
  </enum>

	<schema id="@APP_ID@.sources.bing" path="@RESOURCE_PATH@/sources/bing/">
		<key name="market" enum="@APP_ID@.sources.bing.market">
			<default>"en-US"</default>
		</key>

		<key name="resolution" enum="@APP_ID@.sources.bing.resolution">
			<default>"1920x1080"</default>
		</key>
	</schema>

  <schema id="@APP_ID@.sources.manual" path="@RESOURCE_PATH@/sources/manual/">
    <key name="picture-uri" type="s">
      <default>""</default>
    </key>
  </schema>

  <enum id="@APP_ID@.sources.slideshow.sort_by">
    <value nick="random" value="0"/>
    <value nick="name" value="1"/>
    <value nick="creation-date" value="2"/>
  </enum>
  <schema id="@APP_ID@.sources.slideshow" path="@RESOURCE_PATH@/sources/slideshow/">
    <key name="folder-uri" type="s">
      <default>""</default>
    </key>
    <key name="sort-by" enum="@APP_ID@.sources.slideshow.sort_by">
      <default>"random"</default>
    </key>
  </schema>

  <schema id="@APP_ID@.sources.apod" path="@RESOURCE_PATH@/sources/apod/">
    <key name="api-key" type="s">
      <default>""</default>
    </key>
  </schema>

  <enum id="@APP_ID@.sources.unsplash.content_filter">
    <value nick="low" value="0"/>
    <value nick="high" value="1"/>
  </enum>

  <schema id="@APP_ID@.sources.unsplash" path="@RESOURCE_PATH@/sources/unsplash/">
    <key name="api-key" type="s">
      <default>""</default>
    </key>

    <key name="query" type="s">
      <default>""</default>
    </key>

    <key name="collections" type="s">
      <default>""</default>
    </key>

    <key name="topics" type="s">
      <default>""</default>
    </key>

    <key name="content-filter" enum="@APP_ID@.sources.unsplash.content_filter">
      <default>"low"</default>
    </key>
  </schema>

  <enum id="@APP_ID@.sources.earthview.sort_by">
    <value nick="random" value="0"/>
    <value nick="sequential" value="1"/>
  </enum>

  <schema id="@APP_ID@.sources.earthview" path="@RESOURCE_PATH@/sources/earthview/">
    <key name="sort-by" enum="@APP_ID@.sources.earthview.sort_by">
      <default>"random"</default>
    </key>
  </schema>
</schemalist>
