using Gtk 4.0;
using Adw 1;

template DamaskWindow : Adw.ApplicationWindow {
  default-width: 700;
  default-height: 500;
  title: "Damask";

  Gtk.CheckButton active_source {
    visible: false;
  }

  Adw.ToastOverlay toast_overlay {
    Adw.Leaflet leaflet {
      can-navigate-back: true;
      fold-threshold-policy: natural;

      Gtk.Box sources_list_view {
        orientation: vertical;
        Adw.HeaderBar {
          show-end-title-buttons: bind leaflet.folded;
          title-widget: Adw.WindowTitle {
            title: _("Damask");
            visible: bind leaflet.folded;
          };

          [end]
          MenuButton {
            icon-name: "open-menu-symbolic";
            menu-model: primary_menu;
            visible: bind leaflet.folded;
          }
        }

        Gtk.ScrolledWindow {
          vexpand: true;
          width-request: 300;

          Gtk.ListBox sources {
            selection-mode: browse;
            activate-on-single-click: true;
            styles ["navigation-sidebar"]

            Adw.ActionRow manual_row {
              name: "manual";
              title: _("Manual");
              subtitle: _("Use a manually selected image as the wallpaper");
              activatable: true;

              [prefix]
              Gtk.CheckButton {
                group: active_source;
                action-name: "win.active-source";
                action-target: "'manual'";
              }
            }

            Adw.ActionRow slideshow_row {
              name: "slideshow";
              title: _("Slideshow");
              subtitle: _("Use the contents of a folder as the wallpaper");
              activatable: true;

              [prefix]
              Gtk.CheckButton {
                group: active_source;
                action-name: "win.active-source";
                action-target: "'slideshow'";
              }
            }

            Adw.ActionRow bing_row {
              name: "bing";
              title: _("Bing Wallpaper");
              subtitle: _("Use Microsoft Bing's wallpaper of the day");
              activatable: true;

              [prefix]
              Gtk.CheckButton {
                group: active_source;
                action-name: "win.active-source";
                action-target: "'bing'";
              }
            }

            Adw.ActionRow wallhaven_row {
              name: "wallhaven";
              title: _("Wallhaven");
              subtitle: _("Get wallpapers from wallhaven.cc");
              activatable: true;

              [prefix]
              Gtk.CheckButton {
                group: active_source;
                action-name: "win.active-source";
                action-target: "'wallhaven'";
              }
            }

            Adw.ActionRow apod_row {
              name: "apod";
              title: _("NASA Astronomy Picture of the Day");
              subtitle: _("Each day a different image or photograph of our fascinating universe");
              activatable: true;

              [prefix]
              Gtk.CheckButton {
                group: active_source;
                action-name: "win.active-source";
                action-target: "'apod'";
              }
            }

            Adw.ActionRow unsplash_row {
              name: "unsplash";
              title: _("Unsplash");
              subtitle: _("Get wallpapers from unsplash.com");
              activatable: true;

              [prefix]
              Gtk.CheckButton {
                group: active_source;
                action-name: "win.active-source";
                action-target: "'unsplash'";
              }
            }
          }
        }
      }

      Adw.LeafletPage separator {
        navigatable: false;
        child: Separator {};
      }

      Gtk.Box source_content_view {
        orientation: vertical;
        hexpand: true;

        Adw.HeaderBar {
          show-start-title-buttons: bind leaflet.folded;

          Gtk.Button source_content_back_button {
            visible: bind leaflet.folded;
            icon-name: "go-previous-symbolic";
          }

          [end]
          MenuButton {
            icon-name: "open-menu-symbolic";
            menu-model: primary_menu;
          }

          [end]
          Gtk.Button refresh_button {
            action-name: "app.refresh";
            child: Gtk.Stack refresh_button_stack {
              transition-type: crossfade;
              Gtk.StackPage {
                name: "sensitive";
                child: Gtk.Image {
                  icon-name: "view-refresh-symbolic";
                };
              }
              Gtk.StackPage {
                name: "spinner";
                child: Gtk.Spinner {
                  spinning: true;
                };
              }
            };
          }
        }

        Gtk.Stack source_content_stack {
          Gtk.StackPage {
            name: "manual";
            child: $DamaskSourcesManualPreferencesPage {};
          }
          Gtk.StackPage {
            name: "slideshow";
            child: $DamaskSourcesSlideshowPreferencesPage {};
          }
          Gtk.StackPage {
            name: "bing";
            child: $DamaskSourcesBingPreferencesPage {};
          }
          Gtk.StackPage {
            name: "wallhaven";
            child: $DamaskSourcesWallhavenPreferencesPage {};
          }
          Gtk.StackPage {
            name: "apod";
            child: $DamaskSourcesApodPreferencesPage {};
          }
          Gtk.StackPage {
            name: "unsplash";
            child: $DamaskSourcesUnsplashPreferencesPage {};
          }
        }
      }
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Damask");
      action: "app.about";
    }

    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}