using Gtk 4.0;
using Adw 1;

template DamaskWindow : Adw.ApplicationWindow {
  default-height: 440;
  default-width: 620;
  height-request: 300;
  width-request: 360;
  title: "Damask";

  Adw.Breakpoint {
    condition ("max-width: 540sp")
    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    Adw.NavigationSplitView split_view {
      sidebar: Adw.NavigationPage {
        title: "Damask";
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            Gtk.MenuButton {
              primary: true;
              icon-name: "open-menu-symbolic";
              menu-model: primary_menu;
            }
          }
          content: Gtk.ScrolledWindow {
            Gtk.ListBox sources {
              selection-mode: browse;
              activate-on-single-click: true;
              styles ["navigation-sidebar"]
              row-activated => $on_source_list_activated();

              Adw.PreferencesRow manual_row {
                name: "manual";
                title: _("Manual");
                Gtk.Box {
                  orientation: horizontal;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 6;
                  margin-end: 6;
                  spacing: 12;

                  Gtk.Label {
                    label: bind manual_row.title;
                  }
                }
              }

              Adw.PreferencesRow slideshow_row {
                name: "slideshow";
                title: _("Slideshow");
                Gtk.Box {
                  orientation: horizontal;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 6;
                  margin-end: 6;
                  spacing: 12;

                  Gtk.Label {
                    label: bind slideshow_row.title;
                  }
                }
              }

              Adw.PreferencesRow bing_row {
                name: "bing";
                title: _("Bing Wallpaper");
                Gtk.Box {
                  orientation: horizontal;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 6;
                  margin-end: 6;
                  spacing: 12;

                  Gtk.Label {
                    label: bind bing_row.title;
                  }
                }
              }

              Adw.PreferencesRow wallhaven_row {
                name: "wallhaven";
                title: _("Wallhaven");
                Gtk.Box {
                  orientation: horizontal;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 6;
                  margin-end: 6;
                  spacing: 12;

                  Gtk.Label {
                    label: bind wallhaven_row.title;
                  }
                }
              }

              Adw.PreferencesRow apod_row {
                name: "apod";
                title: _("NASA Astronomy");
                Gtk.Box {
                  orientation: horizontal;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 6;
                  margin-end: 6;
                  spacing: 12;

                  Gtk.Label {
                    label: bind apod_row.title;
                  }
                }
              }

              Adw.PreferencesRow unsplash_row {
                name: "unsplash";
                title: _("Unsplash");
                Gtk.Box {
                  orientation: horizontal;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 6;
                  margin-end: 6;
                  spacing: 12;

                  Gtk.Label {
                    label: bind unsplash_row.title;
                  }
                }
              }

              Adw.PreferencesRow earthview_row {
                name: "earthview";
                title: _("Google Earth View");
                Gtk.Box {
                  orientation: horizontal;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 6;
                  margin-end: 6;
                  spacing: 12;

                  Gtk.Label {
                    label: bind earthview_row.title;
                  }
                }
              }
            }
          };
        };
      };

      content: Adw.NavigationPage source_navigation_page {
        title: "Preferences";
        child: Adw.ToolbarView source_content {
          [top]
          Adw.HeaderBar {
            [end]
            Gtk.Stack refresh_button_stack {
              transition-type: crossfade;
              Gtk.StackPage {
                name: "sensitive";
                child: Gtk.Button refresh_button {
                  action-name: "app.refresh";
                  icon-name: "view-refresh-symbolic";
                };
              }
              Gtk.StackPage {
                name: "spinner";
                child: Adw.Clamp {
                  maximum-size: 16;
                  child: Gtk.Spinner {
                    spinning: true;
                  };
                };
              }
            }
          }
          content: Adw.StatusPage {
            title: _("No Source Selected");
          };
        };
      };
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Damask");
      action: "app.about";
    }

    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}