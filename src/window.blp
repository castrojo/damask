using Gtk 4.0;
using Adw 1;

template DamaskWindow : Adw.ApplicationWindow {
  default-height: 640;
  default-width: 620;
  height-request: 300;
  width-request: 360;
  title: "Damask";

  content: Adw.ToastOverlay toast_overlay {
    Gtk.Box {
      orientation: vertical;

      Adw.ToolbarView {
        extend-content-to-bottom-edge: true;

        [top]
        Adw.HeaderBar {
          title-widget: Gtk.DropDown sources {
            styles ["flat"]
          };

          [end]
          Gtk.MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: primary_menu;
          }

          [end]
          Gtk.Stack refresh_button_stack {
            transition-type: crossfade;
            Gtk.StackPage {
              name: "sensitive";
              child: Gtk.Button refresh_button {
                action-name: "app.refresh";
                icon-name: "view-refresh-symbolic";
                tooltip-text: _("Refresh");
              };
            }
            Gtk.StackPage {
              name: "spinner";
              child: Adw.Clamp {
                maximum-size: 16;
                child: Gtk.Spinner {
                  spinning: true;
                };
              };
            }
          }
        }

        content: Gtk.Box {
          orientation: vertical;

          Adw.Banner banner {
            title: _("Automatic refresh is disabled");
            button-label: _("Enable");
            action-name: "app.enable-automatic-refresh";
          }

          Adw.Bin source_content {
            vexpand: true;
            valign: center;
          }
        };
      }
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("Refresh Automatically");
      action: "app.enable-automatic-refresh";
    }
  }
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Damask");
      action: "app.about";
    }

    item {
      label: _("_Quit");
      action: "app.quit";
    }
  }
}
