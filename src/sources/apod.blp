using Gtk 4.0;
using Adw 1;

template DamaskSourcesApodPreferencesWindow : Adw.PreferencesWindow {
  Adw.PreferencesPage prefs {
    Adw.PreferencesGroup {
      title: "Search";

      Adw.ActionRow {
        title: "API Key";

        Entry api_key {
          placeholder-text: "deadbeef";
          valign: center;
        }
      }
    }
  }
}