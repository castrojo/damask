using Gtk 4.0;
using Adw 1;

template DamaskSourcesApodPreferencesPage : Adw.PreferencesPage {
  Adw.PreferencesGroup {
    $DamaskWallpaperPreview preview {
      source: "apod";
    }
  }

  Adw.PreferencesGroup {
    title: _("Search");

    Adw.EntryRow api_key {
      title: _("API Key");
    }
  }
}
