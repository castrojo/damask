using Gtk 4.0;
using Adw 1;

template DamaskSourcesBingPreferencesWindow : Adw.PreferencesWindow {
  Adw.PreferencesPage prefs {
    Adw.PreferencesGroup {
      Adw.ComboRow market {
        title: _("Market");

        model: StringList {
          strings [
            "en-US",
	          "zh-CN",
	          "ja-JP",
	          "en-AU",
	          "en-GB",
	          "de-DE",
	          "en-NZ",
	          "en-CA",
	          "en-IN",
	          "fr-FR",
	          "fr-CA",
          ]
        };
      }

      Adw.ComboRow resolution {
        title: _("Resolution");

        model: StringList {
          strings [
            "1920x1080",
            "1366x768",
            "UHD (3840x2160)"
          ]
        };
      }
    }
  }
}
