using Gtk 4.0;
using Adw 1;

template DamaskSourcesSlideshowPreferencesWindow : Adw.PreferencesWindow {
  default-width: 360;
  default-height: 400;

  Adw.PreferencesPage prefs {
    Adw.PreferencesGroup {
      Adw.ActionRow choose_folder_row {
        title: _("Choose Folder");

        Gtk.Button choose_button {
          valign: center;
          styles ["flat"]
          icon-name: "document-edit-symbolic";
        }
      }

      Adw.ComboRow sort_by {
        title: _("Sort By");
        model: StringList {
          strings [
            _("Random"),
            _("Name"),
            _("Creation Date")
          ]
        };
      }
    }
  }
}