using Gtk 4.0;
using Adw 1;

template $DamaskSourcesSlideshowPreferencesPage : Adw.PreferencesPage {
  Adw.PreferencesGroup {
    $DamaskWallpaperPreview preview {
      source: "slideshow";
    }
  }

  Adw.PreferencesGroup {
    Adw.ActionRow choose_folder_row {
      title: _("Choose Folder");
      activatable-widget: choose_button;

      Gtk.Button choose_button {
        valign: center;
        styles ["flat"]
        icon-name: "document-edit-symbolic";
      }
    }

    Adw.ComboRow sort_by {
      title: _("Sort By");
      model: StringList {
        strings [
          _("Random"),
          _("Name"),
          _("Creation Date")
        ]
      };
    }
  }
}