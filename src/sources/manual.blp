using Gtk 4.0;
using Adw 1;

template DamaskSourcesManualPreferencesPage : Adw.PreferencesPage {
  Adw.PreferencesGroup {
    $DamaskWallpaperPreview preview {
      source: "manual";
    }
  }

  Adw.PreferencesGroup {
    Adw.ActionRow row {
      title: _("Choose Picture");

      Gtk.Button choose_button {
        valign: center;
        styles ["flat"]
        icon-name: "document-edit-symbolic";
      }
    }
  }
}