using Gtk 4.0;
using Adw 1;

template DamaskSourcesWallhavenPreferencesPage : Adw.PreferencesPage {
  Adw.PreferencesGroup {
    $DamaskWallpaperPreview preview {
      source: "wallhaven";
    }
  }

  Adw.PreferencesGroup {
    description: _("A personal API key is required to access private collections and other sensitive content. An API key can be generated by visiting <a href=\"https://wallhaven.cc/settings/account\">wallhaven.cc</a>.");

    CheckButton search_mode {
      visible: false;
    }

    Adw.EntryRow api_key {
      title: _("API Key");
      show-apply-button: true;
    }
  }

  Adw.PreferencesGroup {
    title: _("Search");

    Adw.ExpanderRow {
      title: _("Query");

      [prefix]
      CheckButton search_mode_query {
        group: search_mode;
      }

      Adw.EntryRow query {
        title: _("Query");
        show-apply-button: true;

        [suffix]
        Gtk.Button syntax_help {
          styles ["flat"]
          icon-name: "dialog-information-symbolic";
          valign: center;
        }
      }
    }

    Adw.ExpanderRow {
      title: _("Collection");

      [prefix]
      CheckButton search_mode_collections {
        group: search_mode;
      }

      Adw.EntryRow username {
        title: _("Username");
      }

      Adw.ComboRow collections {
        title: _("Collections");
      }
    }
  }

  Adw.PreferencesGroup {
    title: _("Sorting");

    Adw.ComboRow sort_by {
      title: _("Sort By");

      model: StringList {
        strings [
          _("Date Added"),
          _("Relevance"),
          _("Random"),
          _("Views"),
          _("Favorites"),
          _("Top List"),
        ]
      };
    }

    Adw.ComboRow sort_order {
      title: _("Sort Order");

      model: StringList {
        strings [
          _("Ascending"),
          _("Descending"),
        ]
      };
    }

    Adw.ComboRow top_list_range {
      title: _("Top List Range");

      model: StringList {
        strings [
          _("One Day"),
          _("Three Days"),
          _("One Week"),
          _("One Month"),
          _("Three Months"),
          _("Six Months"),
          _("One Year"),
        ]
      };
    }
  }

  Adw.PreferencesGroup {
    title: _("Filtering");

    Adw.SwitchRow color_enabled {
      title: _("Color");

      [suffix]
      Gtk.Button color_button {
        valign: center;
        sensitive: bind color_enabled.active;

        Gtk.Popover color_popover {}
      }
    }
  }

  Adw.PreferencesGroup {
    title: _("Categories");

    Adw.SwitchRow category_general {
      title: _("General");
    }

    Adw.SwitchRow category_anime {
      title: _("Anime");
    }

    Adw.SwitchRow category_people {
      title: _("People");
    }
  }

  Adw.PreferencesGroup {
    title: _("Purity");

    Adw.SwitchRow purity_sfw {
      title: _("Safe for Work");
    }

    Adw.SwitchRow purity_sketchy {
      title: _("Sketchy");
    }

    Adw.SwitchRow purity_nsfw {
      title: _("Not Safe for Work");
      subtitle: _("An API key is required to access not safe for work content");
    }
  }
}
