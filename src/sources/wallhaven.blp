using Gtk 4.0;
using Adw 1;

template DamaskSourcesWallhavenPreferencesPage : Adw.PreferencesPage {
  Adw.PreferencesGroup {
    $DamaskWallpaperPreview preview {
      source: "wallhaven";
    }
  }

  Adw.PreferencesGroup {
    title: _("Source");

    CheckButton search_mode {
      visible: false;
    }

    Adw.ActionRow {
      title: _("API Key");
      activatable-widget: api_key;

      Entry api_key {
        placeholder-text: _("deadbeef");
        valign: center;
      }
    }

    Adw.ExpanderRow {
      title: _("Query");

      [prefix]
      CheckButton search_mode_query {
        group: search_mode;
      }

      Adw.ActionRow {
        title: _("Query");

        Button syntax_help {
          styles ["flat"]
          icon-name: "dialog-information-symbolic";
          valign: center;
        }

        Entry query {
          placeholder-text: _("space galaxy");
          valign: center;
        }
      }
    }

    Adw.ExpanderRow {
      title: _("Collection");

      [prefix]
      CheckButton search_mode_collections {
        group: search_mode;
      }

      Adw.ActionRow {
        title: _("Username");
        Entry username {
          placeholder-text: _("kermit_the_frog");
          valign: center;
        }
      }

      Adw.ComboRow collections {
        title: _("Collections");
      }
    }
  }

  Adw.PreferencesGroup {
    title: _("Sorting");

    Adw.ComboRow sort_by {
      title: _("Sort By");

      model: StringList {
        strings [
          _("Date Added"),
          _("Relevance"),
          _("Random"),
          _("Views"),
          _("Favorites"),
          _("Top List"),
        ]
      };
    }

    Adw.ComboRow sort_order {
      title: _("Sort Order");

      model: StringList {
        strings [
          _("Ascending"),
          _("Descending"),
        ]
      };
    }

    Adw.ComboRow top_list_range {
      title: _("Top List Range");

      model: StringList {
        strings [
          _("One Day"),
          _("Three Days"),
          _("One Week"),
          _("One Month"),
          _("Three Months"),
          _("Six Months"),
          _("One Year"),
        ]
      };
    }
  }

  Adw.PreferencesGroup {
    title: _("Filtering");

    Adw.ActionRow color2 {
      title: _("Color");
      activatable-widget: color_enabled;

      Gtk.Button color_button {
        valign: center;
        sensitive: bind color_enabled.active;

        Gtk.Popover color_popover {}
      }

      Gtk.Switch  color_enabled {
        valign: center;
      }
    }
  }

  Adw.PreferencesGroup {
    title: _("Categories");

    Adw.ActionRow {
      title: _("General");
      activatable-widget: category_general;

      Switch category_general {
        valign: center;
      }
    }

    Adw.ActionRow {
      title: _("Anime");
      activatable-widget: category_anime;

      Switch category_anime {
        valign: center;
      }
    }

    Adw.ActionRow {
      title: _("People");
      activatable-widget: category_people;

      Switch category_people {
        valign: center;
      }
    }
  }

  Adw.PreferencesGroup {
    title: _("Purity");

    Adw.ActionRow {
      title: _("Safe for Work");
      activatable-widget: purity_sfw;

      Switch purity_sfw {
        valign: center;
      }
    }

    Adw.ActionRow {
      title: _("Sketchy");
      activatable-widget: purity_sketchy;

      Switch purity_sketchy {
        valign: center;
      }
    }

    Adw.ActionRow {
      title: _("Not Safe for Work");
      subtitle: _("An API key is required to access not safe for work content");
      activatable-widget: purity_nsfw;

      Switch purity_nsfw {
        valign: center;
      }
    }
  }
}
