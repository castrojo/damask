using Gtk 4.0;
using Adw 1;

template DamaskSourcesNonePreferencesPage : Adw.PreferencesPage {
  Adw.PreferencesGroup {
    Adw.StatusPage {
        icon-name: "image-missing-symbolic";
        title: _("No Source");
        description: _("Select a wallpaper source from the dropdown to use Damask");
    }
  }
}
