using Gtk 4.0;
using Adw 1;

template DamaskInfoWindow : Adw.ApplicationWindow {
  default-width: 200;
  Box {
    orientation: vertical;

    HeaderBar {
      styles ["flat"]
    }

    Adw.Clamp {
      maximum-size: 300;
      child: Box {
        orientation: vertical;
        margin-top: 24;
        margin-start: 24;
        margin-end: 24;

        Gtk.Picture preview_picture {
          styles ["card"]
          content-fit: contain;
          can-shrink: false;
          width-request: 300;
        }

        Gtk.Label description_label {
          styles ["caption"]
          wrap: true;
          wrap-mode: word;
          margin-top: 12;
        }
      };
    }

    Adw.Clamp {
      child: Box {
        orientation: vertical;
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 12;
        margin-end: 12;
        spacing: 24;

        Gtk.ListBox {
          selection-mode: none;
          styles ["boxed-list"]

          Adw.ActionRow {
            title: "Webpage";
            action-name: "win.open-url";
            activatable: true;

            Gtk.Image {
              icon-name: "adw-external-link-symbolic";
            }
          }

          Adw.ActionRow {
            title: "Resolution";
            visible: bind resolution_label.visible;

            Gtk.Label resolution_label {
              valign: center;
            }
          }
        }
      };
    }
  }
}
