using Gtk 4.0;
using Adw 1;

template $DamaskPreferencesWindow : Adw.PreferencesDialog {
  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      Adw.ComboRow refresh_interval {
        title: _("Refresh Interval");

        model: StringList {
          strings [
            _("30 seconds"),
            _("1 minute"),
            _("5 minutes"),
            _("15 minutes"),
            _("30 minutes"),
            _("1 hour"),
            _("6 hours"),
            _("12 hours"),
            _("24 hours")
          ]
        };
      }
      Adw.ActionRow {
        title: _("Run in Background");
        activatable-widget: run_in_background;
        Switch run_in_background {
          valign: center;
        }
      }
    }
  }
}
