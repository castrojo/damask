using Gtk 4.0;
using Adw 1;

template $DamaskWallpaperPreview : Gtk.Box {
  orientation: vertical;

  Adw.Clamp {
    maximum-size: 300;
    child: Gtk.Overlay {
      child: Gtk.Stack stack {
        transition-type: crossfade;
        Gtk.StackPage placeholder {
          name: "placeholder";
          child: Adw.StatusPage {
            icon-name: "image-missing-symbolic";
            height-request: 200;
            width-request: 300;
          };
        }
        Gtk.StackPage page1 {
          name: "picture1";
          child: Gtk.Picture picture1 {
            styles ["card"]
            content-fit: cover;
            can-shrink: true;
          };
        }
        Gtk.StackPage page2 {
          name: "picture2";
          child: Gtk.Picture picture2 {
            styles ["card"]
            content-fit: cover;
            can-shrink: true;
          };
        }
      };

      [overlay]
      Gtk.Button open_url {
        styles ["osd", "circular"]
        halign: end;
        valign: end;
        margin-bottom: 12;
        margin-end: 12;
        icon-name: "adw-external-link-symbolic";
        action-name: "win.open-url";
        tooltip-text: _("Open in Browser");
        visible: false;
      }
    };
  }

  Gtk.Label title {
    styles ["heading"]
    margin-top: 12;
    visible: false;
  }

  Gtk.Label description {
    styles ["caption"]
    wrap: true;
    ellipsize: end;
    lines: 3;
    margin-top: 6;
    margin-bottom: 6;
    visible: false;
  }

  Gtk.Label attribution {
    styles ["caption", "dim-label"]
    margin-top: 3;
    margin-bottom: 3;
    visible: false;
  }

}
